# Local development only. Copy to .env.local (ignored by git) and adjust if needed.
# Browser-visible values only: VITE_* variables are public and are inlined into the bundle.
# Local Spring API and local Keycloak realm (see docs/KEYCLOAK-LOCAL.md).
# Generic Compose/dev default is API port 8080. For the Phase 4 host-run API on port 8082, override this variable when starting Vite; see docs/PHASE4-HOST-RUNTIME.md.
VITE_WATSCAPE_API_BASE_URL=http://localhost:8080
VITE_OIDC_AUTHORITY=http://localhost:8081/realms/wattscape-local
VITE_OIDC_CLIENT_ID=wattscape-local
