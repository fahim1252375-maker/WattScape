# Local-only values. Generate backend/.env with scripts/create-local-env.sh.
# Never use this dev realm/client for production.
POSTGRES_DB=wattscape
POSTGRES_USER=wattscape
POSTGRES_PASSWORD=generate-local-secret
DATABASE_URL=jdbc:postgresql://postgres:5432/wattscape
DATABASE_USERNAME=wattscape
DATABASE_PASSWORD=generate-local-secret
JWT_ISSUER_URI=http://localhost:8081/realms/wattscape-local
JWT_JWK_SET_URI=http://localhost:8081/realms/wattscape-local/protocol/openid-connect/certs
JWT_AUDIENCE=wattscape-api
JWT_ORGANIZATION_CLAIM=organization_id
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
DB_POOL_SIZE=12
KC_BOOTSTRAP_ADMIN_USERNAME=local-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=generate-local-secret
KEYCLOAK_ADMIN_URL=http://localhost:8081
KEYCLOAK_REALM=wattscape-local
WATSCAPE_ADMIN_USERNAME=local-admin
WATSCAPE_ADMIN_PASSWORD=generate-local-secret
WATSCAPE_MEMBER_USERNAME=local-member
WATSCAPE_MEMBER_PASSWORD=generate-local-secret
WATSCAPE_ORG_ID=20000000-0000-4000-8000-000000000001
GOOGLE_IDP_ENABLED=false
APPLE_IDP_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_SERVICES_ID=
APPLE_PRIVATE_KEY_FILE=/secure/local/path/AuthKey.p8
APPLE_CLIENT_SECRET_JWT=
# Generated and rotated by backend/keycloak/renew-apple-client-secret.py; never commit backend/.env.
KC_EMAIL_HOST=mailpit
KC_EMAIL_PORT=1025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=no-reply@wattscape.local
APP_PUBLIC_URL=http://localhost:3000
# Configure social provider credentials only in backend/.env and Keycloak Admin Console.
# Never add provider client secrets to a VITE_ variable.

# Server-side AI is disabled by default. Keep credentials out of VITE_* variables.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com
AI_API_KEY=
AI_MODEL=gpt-4o-mini
