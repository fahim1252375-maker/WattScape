# EXAMPLE ONLY — values below are placeholders, not usable credentials.
# Configure real values in the backend service's protected environment/secret manager.
# Never populate this file with production secrets or commit an edited copy.

# Managed PostgreSQL — use Railway private networking and TLS.
DATABASE_URL=jdbc:postgresql://REPLACE_PRIVATE_DB_HOST:5432/wattscape?sslmode=require
DATABASE_USERNAME=REPLACE_APP_DB_ROLE
DATABASE_PASSWORD=REPLACE_IN_SECRET_STORE
DB_POOL_SIZE=12

# Keycloak production issuer and API audience.
JWT_ISSUER_URI=https://identity.example.com/realms/wattscape
JWT_JWK_SET_URI=https://identity.example.com/realms/wattscape/protocol/openid-connect/certs
JWT_AUDIENCE=wattscape-api
JWT_ORGANIZATION_CLAIM=organization_id

# Exact public frontend origin only.
CORS_ALLOWED_ORIGINS=https://app.example.com
APP_PUBLIC_URL=https://app.example.com

# Authenticated production SMTP. Keycloak realm email requires its own SMTP configuration too.
SMTP_HOST=REPLACE_SMTP_HOST
SMTP_PORT=587
SMTP_USERNAME=REPLACE_IN_SECRET_STORE
SMTP_PASSWORD=REPLACE_IN_SECRET_STORE
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=no-reply@example.com

# Optional identity providers; keep disabled until configured in Keycloak.
GOOGLE_IDP_ENABLED=false
APPLE_IDP_ENABLED=false

# Optional AI integration; keep disabled until data transfer is approved.
AI_ENABLED=false
AI_BASE_URL=https://api.openai.com
AI_API_KEY=REPLACE_IN_SECRET_STORE
AI_MODEL=gpt-4o-mini

# Railway supplies PORT at runtime; Spring defaults to 8080 when unset.
PORT=8080
