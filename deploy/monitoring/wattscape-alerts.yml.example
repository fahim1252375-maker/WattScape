groups:
  - name: wattscape-api
    rules:
      - alert: WattScapePrometheusTargetDown
        expr: up{job="wattscape-api"} == 0
        for: 2m
        labels:
          severity: critical
          service: wattscape-api
        annotations:
          summary: WattScape metrics scrape is unavailable
          description: Check the private network route, certificate, bearer-token rotation, and API readiness.

      - alert: WattScapeHigh5xxRate
        expr: |
          sum(rate(http_server_requests_seconds_count{job="wattscape-api",status=~"5.."}[5m]))
          / clamp_min(sum(rate(http_server_requests_seconds_count{job="wattscape-api"}[5m])), 1)
          > 0.05
        for: 10m
        labels:
          severity: warning
          service: wattscape-api
        annotations:
          summary: WattScape API 5xx ratio is above 5%
          description: Review structured API logs using request IDs; do not expose tokens or request bodies.

      - alert: WattScapeHighP95Latency
        expr: |
          histogram_quantile(0.95,
            sum by (le) (rate(http_server_requests_seconds_bucket{job="wattscape-api"}[5m])))
          > 1.5
        for: 10m
        labels:
          severity: warning
          service: wattscape-api
        annotations:
          summary: WattScape API p95 latency exceeds 1.5 seconds
          description: Review route-template latency and database pool saturation before scaling.

      - alert: WattScapeJvmHeapHigh
        expr: |
          sum(jvm_memory_used_bytes{job="wattscape-api",area="heap"})
          / clamp_min(sum(jvm_memory_max_bytes{job="wattscape-api",area="heap"}), 1)
          > 0.85
        for: 10m
        labels:
          severity: warning
          service: wattscape-api
        annotations:
          summary: WattScape JVM heap use is above 85%
          description: Check heap trend and garbage collection before adjusting memory limits.

      - alert: WattScapeDatabasePoolSaturated
        expr: |
          max(hikaricp_connections_active{job="wattscape-api"})
          / clamp_min(max(hikaricp_connections_max{job="wattscape-api"}), 1)
          > 0.9
        for: 5m
        labels:
          severity: warning
          service: wattscape-api
        annotations:
          summary: WattScape database connection pool is above 90% active
          description: Check query latency and configured DB_POOL_SIZE against managed PostgreSQL limits.

      - alert: WattScapeAuthDenialsElevated
        expr: |
          sum(rate(http_server_requests_seconds_count{job="wattscape-api",status=~"401|403"}[5m])) > 5
        for: 10m
        labels:
          severity: info
          service: wattscape-api
        annotations:
          summary: WattScape authentication denials are elevated
          description: Validate expected sign-in traffic and abuse signals; do not log or label identities.
