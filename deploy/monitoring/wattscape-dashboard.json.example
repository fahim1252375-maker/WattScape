{
  "__inputs": [{"name":"DS_PROMETHEUS","label":"Prometheus","description":"Private WattScape scrape source","type":"datasource","pluginId":"prometheus","pluginName":"Prometheus"}],
  "__requires": [{"type":"grafana","id":"grafana","name":"Grafana","version":"10.0.0"},{"type":"datasource","id":"prometheus","name":"Prometheus","version":"1.0.0"}],
  "title": "WattScape API Operations",
  "uid": "wattscape-api-ops",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from":"now-6h","to":"now"},
  "panels": [
    {"id":1,"type":"timeseries","title":"HTTP request rate","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"h":8,"w":12,"x":0,"y":0},"targets":[{"expr":"sum by (status) (rate(http_server_requests_seconds_count{job=\"wattscape-api\"}[5m]))","legendFormat":"{{status}}","refId":"A"}]},
    {"id":2,"type":"timeseries","title":"HTTP p95 latency (seconds)","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"h":8,"w":12,"x":12,"y":0},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"wattscape-api\"}[5m])))","legendFormat":"p95","refId":"A"}]},
    {"id":3,"type":"timeseries","title":"JVM heap used ratio","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"h":8,"w":8,"x":0,"y":8},"targets":[{"expr":"sum(jvm_memory_used_bytes{job=\"wattscape-api\",area=\"heap\"}) / clamp_min(sum(jvm_memory_max_bytes{job=\"wattscape-api\",area=\"heap\"}), 1)","legendFormat":"heap ratio","refId":"A"}]},
    {"id":4,"type":"timeseries","title":"Hikari active / max connections","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"h":8,"w":8,"x":8,"y":8},"targets":[{"expr":"max(hikaricp_connections_active{job=\"wattscape-api\"})","legendFormat":"active","refId":"A"},{"expr":"max(hikaricp_connections_max{job=\"wattscape-api\"})","legendFormat":"max","refId":"B"}]},
    {"id":5,"type":"timeseries","title":"Authentication denials per second","datasource":{"type":"prometheus","uid":"${DS_PROMETHEUS}"},"gridPos":{"h":8,"w":8,"x":16,"y":8},"targets":[{"expr":"sum by (status) (rate(http_server_requests_seconds_count{job=\"wattscape-api\",status=~\"401|403\"}[5m]))","legendFormat":"{{status}}","refId":"A"}]}
  ]
}
