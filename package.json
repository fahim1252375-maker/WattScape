{
  "name": "wattscape",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run src/auth src/config src/context src/services src/views && node --import tsx --test src/domain/calculations.test.ts src/domain/validation.test.ts",
    "test:watch": "vitest src/auth src/config src/context src/services src/views",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.e2e.json",
    "lint": "oxlint --react-plugin --max-warnings 11 src",
    "check": "bun run typecheck && bun run lint && bun run test && bun run build",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "oxlint": "1.94.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "packageManager": "bun@1.4.5",
  "engines": {
    "node": ">=22.14.0 <25"
  }
}
